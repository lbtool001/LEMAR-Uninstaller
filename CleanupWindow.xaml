<Window x:Class="LEMAR.Uninstaller.CleanupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/LEMAR-Uninstaller.ico" Title="Review leftovers" Width="660" Height="440" MinWidth="560" MinHeight="340" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontWeight="Bold" FontSize="18" Text="Leftover scan"/>
  <TextBlock Grid.Row="1" Text="Conservative scan: exact per-user AppData folders and registry keys only. Review carefully; shared data may remain." TextWrapping="Wrap" Margin="0,10,0,12" Foreground="{DynamicResource MutedBrush}"/>
  <DataGrid Grid.Row="2" x:Name="Results" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource AlternateBrush}" BorderThickness="0">
   <DataGrid.Columns><DataGridCheckBoxColumn Header="Select" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" IsReadOnly="True" Width="95"/><DataGridTextColumn Header="Location" Binding="{Binding Path}" IsReadOnly="True" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="Remove Selected (backup first)" Click="Delete_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"/><Button Content="Select All" Click="SelectAll_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,8,0"/><TextBlock x:Name="Info" Text="Review items before removing" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
 </Grid>
</Window>